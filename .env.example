# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Razorpay Payment Gateway Credentials (Server-side only — never prefix with VITE_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Sheets Apps Script Webhook URL (Optional server-side reporting sync)
GOOGLE_SHEETS_WEBHOOK_URL=
